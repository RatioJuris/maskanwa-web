<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= page.title || 'Maskanwa Open Community' %></title>

    <meta
        name="description"
        content="<%= page.description || 'The central digital directory for schools, colleges, shops, businesses and services in Maskanwa.' %>"
    >

    <meta name="robots" content="index, follow">

    <link
        rel="canonical"
        href="<%= page.canonical || 'https://maskanwa.com/' %>"
    >

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta
        property="og:url"
        content="<%= page.canonical || 'https://maskanwa.com/' %>"
    >
    <meta
        property="og:title"
        content="<%= page.title || 'Maskanwa Open Community' %>"
    >
    <meta
        property="og:description"
        content="<%= page.description || 'Discover Maskanwa online.' %>"
    >
    <meta
        property="og:site_name"
        content="Maskanwa Open Community"
    >

    <% if (page.image) { %>
    <meta property="og:image" content="<%= page.image %>">
    <% } %>

    <!-- Twitter / WhatsApp -->
    <meta name="twitter:card" content="summary_large_image">
    <meta
        name="twitter:title"
        content="<%= page.title || 'Maskanwa Open Community' %>"
    >
    <meta
        name="twitter:description"
        content="<%= page.description || 'Discover Maskanwa online.' %>"
    >

    <% if (page.image) { %>
    <meta name="twitter:image" content="<%= page.image %>">
    <% } %>

    <meta name="theme-color" content="#0f172a">

    <!-- Platform favicon -->
    <link
        rel="icon"
        href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230f172a'/><text x='50' y='70' font-size='65' font-family='system-ui,sans-serif' font-weight='bold' fill='white' text-anchor='middle'>M</text></svg>"
    >

    <!-- JSON-LD -->
    <script type="application/ld+json">
    <%- structuredData %>
    </script>

    <style>
        :root {
            --primary: #0f172a;
            --accent: #2563eb;
            --accent-dark: #1d4ed8;

            --bg: #f8fafc;
            --surface: #ffffff;
            --surface-soft: #f1f5f9;

            --text: #0f172a;
            --muted: #64748b;
            --border: #e2e8f0;

            --radius: 14px;
            --max-width: 1200px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;

            background: var(--bg);
            color: var(--text);

            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            line-height: 1.6;

            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }

        a {
            color: inherit;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        /* =========================================
           HEADER
        ========================================= */

        header {
            position: sticky;
            top: 0;
            z-index: 1000;

            background: rgba(255,255,255,.92);

            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);

            border-bottom: 1px solid var(--border);
        }

        .header-inner {
            width: min(100%, var(--max-width));

            margin: auto;

            padding: 1rem 1.5rem;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 1rem;
        }

        .brand {
            color: var(--primary);

            text-decoration: none;

            font-size: 1.15rem;
            font-weight: 800;

            letter-spacing: -.025em;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        nav a {
            color: var(--muted);

            text-decoration: none;

            font-size: .92rem;
            font-weight: 550;
        }

        nav a:hover {
            color: var(--primary);
        }

        /* =========================================
           HERO
        ========================================= */

        .hero {
            position: relative;

            padding:
                clamp(4rem, 9vw, 7rem)
                1.5rem
                clamp(4rem, 8vw, 6rem);

            text-align: center;

            background:
                radial-gradient(
                    circle at top,
                    rgba(37,99,235,.08),
                    transparent 55%
                ),
                linear-gradient(
                    180deg,
                    #ffffff,
                    #f8fafc
                );

            border-bottom: 1px solid var(--border);

            overflow: hidden;
        }

        .hero-inner {
            width: min(100%, 900px);
            margin: auto;
        }

        .hero h1 {
            margin: 0;

            font-size:
                clamp(2.5rem, 8vw, 5rem);

            line-height: 1;

            font-weight: 850;

            letter-spacing: -.055em;
        }

        .hero h1 span {
            color: var(--accent);
        }

        .hero-subtitle {
            min-height: 3.5rem;

            margin-top: 1.5rem;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        .typing-text {
            color: var(--primary);

            font-size:
                clamp(1.35rem, 4vw, 2.3rem);

            font-weight: 750;

            letter-spacing: -.035em;
        }

        .dynamic-word {
            color: var(--accent);

            position: relative;
        }

        .dynamic-word::after {
            content: "|";

            position: absolute;
            right: -.65rem;

            animation: blink 1s step-end infinite;
        }

        @keyframes blink {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0;
            }
        }

        .hero-description {
            max-width: 700px;

            margin: 1.5rem auto 0;

            color: var(--muted);

            font-size:
                clamp(1rem, 2vw, 1.15rem);
        }

        .hero-actions {
            margin-top: 2rem;

            display: flex;
            justify-content: center;

            flex-wrap: wrap;

            gap: .75rem;
        }

        .hero-button {
            display: inline-block;

            padding: .85rem 1.4rem;

            border-radius: 999px;

            text-decoration: none;

            font-weight: 700;

            transition:
                transform .2s,
                box-shadow .2s;
        }

        .hero-button.primary {
            background: var(--primary);
            color: white;

            box-shadow:
                0 10px 20px rgba(15,23,42,.12);
        }

        .hero-button.secondary {
            background: white;
            color: var(--primary);

            border: 1px solid var(--border);
        }

        .hero-button:hover {
            transform: translateY(-2px);
        }

        /* =========================================
           MAIN
        ========================================= */

        main {
            width: min(100%, var(--max-width));

            margin: auto;

            padding:
                4rem
                1.5rem
                5rem;
        }

        .content-wrapper {
            margin-bottom: 4rem;
        }

        .content-wrapper > :first-child {
            margin-top: 0;
        }

        /* =========================================
           DIRECTORY
        ========================================= */

        .directory-heading {
            padding-top: 3rem;

            border-top: 1px solid var(--border);

            text-align: center;
        }

        .directory-heading h2 {
            margin: 0;

            font-size:
                clamp(1.8rem, 4vw, 2.5rem);

            letter-spacing: -.035em;
        }

        .directory-heading p {
            margin: .75rem auto 0;

            max-width: 650px;

            color: var(--muted);
        }

        /* =========================================
           CONTROLS
        ========================================= */

        .controls {
            max-width: 850px;

            margin: 2.5rem auto;

            display: flex;
            flex-direction: column;

            gap: 1rem;
        }

        .search-bar input {
            width: 100%;

            padding: 1rem 1.25rem;

            border:
                2px solid
                var(--border);

            border-radius: 999px;

            background: white;

            color: var(--text);

            font-size: 1rem;

            outline: none;

            box-shadow:
                0 5px 15px
                rgba(15,23,42,.04);

            transition:
                border-color .2s,
                box-shadow .2s;
        }

        .search-bar input:focus {
            border-color: var(--accent);

            box-shadow:
                0 0 0 4px
                rgba(37,99,235,.1);
        }

        .filters {
            display: flex;

            justify-content: center;

            flex-wrap: wrap;

            gap: .5rem;
        }

        .filter-btn {
            padding: .5rem 1rem;

            border:
                1px solid
                var(--border);

            border-radius: 999px;

            background: white;

            color: var(--muted);

            cursor: pointer;

            font-size: .88rem;
            font-weight: 600;

            transition:
                background .2s,
                color .2s,
                border-color .2s;
        }

        .filter-btn:hover {
            color: var(--text);
            border-color: #cbd5e1;
        }

        .filter-btn.active {
            background: var(--primary);
            border-color: var(--primary);

            color: white;
        }

        /* =========================================
           DIRECTORY GRID
        ========================================= */

        .directory {
            display: grid;

            grid-template-columns:
                repeat(
                    auto-fill,
                    minmax(280px, 1fr)
                );

            gap: 1rem;
        }

        .card {
            display: flex;
            flex-direction: column;

            min-height: 150px;

            padding: 1.4rem;

            background: white;

            border:
                1px solid
                var(--border);

            border-radius: var(--radius);

            color: inherit;

            text-decoration: none;

            box-shadow:
                0 2px 5px
                rgba(15,23,42,.03);

            transition:
                transform .2s ease,
                box-shadow .2s ease,
                border-color .2s ease;
        }

        .card:hover {
            transform: translateY(-3px);

            border-color: #cbd5e1;

            box-shadow:
                0 12px 30px
                rgba(15,23,42,.08);
        }

        .badge {
            align-self: flex-start;

            margin-bottom: .8rem;

            padding: .25rem .65rem;

            background: #eff6ff;

            color: #1d4ed8;

            border-radius: 999px;

            font-size: .7rem;

            font-weight: 750;

            text-transform: uppercase;

            letter-spacing: .06em;
        }

        .card h3 {
            margin: 0;

            font-size: 1.15rem;

            line-height: 1.3;

            font-weight: 700;
        }

        .card p {
            margin: .35rem 0 0;

            color: var(--muted);

            font-size: .88rem;

            overflow-wrap: anywhere;
        }

        .no-results {
            grid-column: 1 / -1;

            display: none;

            padding: 3rem;

            text-align: center;

            color: var(--muted);
        }

        /* =========================================
           FOOTER
        ========================================= */

        footer {
            padding: 3rem 1.5rem;

            text-align: center;

            background: white;

            color: var(--muted);

            border-top: 1px solid var(--border);

            font-size: .9rem;
        }

        footer p {
            margin: 0;
        }

        footer a {
            color: var(--accent);

            text-decoration: none;

            font-weight: 650;
        }

        .update-badge {
            display: inline-block;

            margin-top: 1rem;

            padding: .3rem .75rem;

            background: var(--bg);

            border:
                1px solid
                var(--border);

            border-radius: 7px;

            font-family: ui-monospace, monospace;

            font-size: .78rem;
        }

        /* =========================================
           ANIMATION
        ========================================= */

        .fade-in-up {
            opacity: 0;

            transform:
                translateY(18px);

            transition:
                opacity .6s ease,
                transform .6s ease;
        }

        .fade-in-up.visible {
            opacity: 1;

            transform:
                translateY(0);
        }

        /* =========================================
           MOBILE
        ========================================= */

        @media (max-width: 650px) {

            .header-inner {
                padding:
                    .85rem 1rem;
            }

            nav {
                gap: .7rem;
            }

            nav a {
                font-size: .82rem;
            }

            nav a[href$="/about"],
            nav a[href$="/join"] {
                display: none;
            }

            main {
                padding:
                    3rem 1rem 4rem;
            }

            .directory {
                grid-template-columns: 1fr;
            }

            .hero {
                padding:
                    4rem 1rem;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }

            .fade-in-up {
                opacity: 1;
                transform: none;
            }
        }
    </style>
</head>

<body>

<header>
    <div class="header-inner">

        <a
            href="https://maskanwa.com"
            class="brand"
        >
            Maskanwa
        </a>

        <nav aria-label="Primary navigation">
            <a href="https://maskanwa.com">
                Home
            </a>

            <a href="https://maskanwa.com/about">
                About
            </a>

            <a href="https://maskanwa.com/join">
                Join
            </a>
        </nav>

    </div>
</header>


<% if (page.title === site.name) { %>

<section class="hero">

    <div class="hero-inner">

        <h1 class="fade-in-up">
            Maskanwa<span>.com</span>
        </h1>

        <div class="hero-subtitle fade-in-up">
            <div class="typing-text">
                Kya Aapka
                <span
                    id="typewriter"
                    class="dynamic-word"
                >School</span>
                Yahan Hai?
            </div>
        </div>

        <p class="hero-description fade-in-up">
            <%= page.description ||
                'Maskanwa’s official digital directory. Find top schools, colleges, local shops, and emergency services instantly on a single, 100% free community hub.' %>
        </p>

        <div class="hero-actions fade-in-up">

            <a
                href="https://maskanwa.com/join"
                class="hero-button primary"
            >
                Join the Network — It's Free
            </a>

            <a
                href="#directory"
                class="hero-button secondary"
            >
                Explore Maskanwa
            </a>

        </div>

    </div>

</section>

<% } %>


<main>

    <div class="content-wrapper fade-in-up">
        <%- content %>
    </div>


    <% if (page.title === site.name) { %>

    <section id="directory">

        <div class="directory-heading fade-in-up">

            <h2>
                Explore Maskanwa
            </h2>

            <p>
                Find schools, colleges, shops, healthcare,
                services and other local entities.
            </p>

        </div>


        <div class="controls fade-in-up">

            <div class="search-bar">

                <input
                    type="search"
                    id="searchInput"
                    placeholder="Search Maskanwa..."
                    aria-label="Search Maskanwa directory"
                    autocomplete="off"
                >

            </div>


            <div
                class="filters"
                id="filterContainer"
                aria-label="Directory categories"
            >

                <button
                    type="button"
                    class="filter-btn active"
                    data-filter="all"
                >
                    All
                </button>

                <button
                    type="button"
                    class="filter-btn"
                    data-filter="education"
                >
                    Education
                </button>

                <button
                    type="button"
                    class="filter-btn"
                    data-filter="store"
                >
                    Shops & Stores
                </button>

                <button
                    type="button"
                    class="filter-btn"
                    data-filter="health"
                >
                    Healthcare
                </button>

                <button
                    type="button"
                    class="filter-btn"
                    data-filter="service"
                >
                    Services
                </button>

            </div>

        </div>


        <div
            class="directory"
            id="directoryGrid"
        >

            <% (institutions || []).forEach(function(inst) {

                const name =
                    String(inst.name || 'Unnamed');

                const type =
                    String(inst.type || 'Service');

                const domain =
                    String(inst.domain || '');

                const lowerType =
                    type.toLowerCase();

                let category = 'service';

                if (
                    lowerType.includes('school') ||
                    lowerType.includes('college') ||
                    lowerType.includes('institute') ||
                    lowerType.includes('university') ||
                    lowerType.includes('coaching')
                ) {
                    category = 'education';

                } else if (
                    lowerType.includes('store') ||
                    lowerType.includes('shop') ||
                    lowerType.includes('pharmacy') ||
                    lowerType.includes('kirana')
                ) {
                    category = 'store';

                } else if (
                    lowerType.includes('hospital') ||
                    lowerType.includes('clinic') ||
                    lowerType.includes('pathology') ||
                    lowerType.includes('medical')
                ) {
                    category = 'health';
                }

            %>

                <a
                    href="https://<%= domain %>"
                    class="card fade-in-up"
                    data-category="<%= category %>"
                    data-search="<%= name.toLowerCase() %> <%= type.toLowerCase() %>"
                >

                    <span class="badge">
                        <%= type %>
                    </span>

                    <h3>
                        <%= name %>
                    </h3>

                    <% if (domain) { %>
                    <p>
                        <%= domain %>
                    </p>
                    <% } %>

                </a>

            <% }); %>


            <div
                class="no-results"
                id="noResults"
            >
                No listings found.
            </div>

        </div>

    </section>

    <% } %>

</main>


<footer>

    <p>
        &copy;
        <%= new Date().getFullYear() %>
        Maskanwa Open Community.
    </p>

    <p>
        A community-built digital directory for Maskanwa.
    </p>

    <div class="update-badge">
        Updated: <%= buildTime %>
    </div>

</footer>


<script>
document.addEventListener(
    'DOMContentLoaded',
    function () {

        /*
         * ==========================================
         * Scroll reveal
         * ==========================================
         */

        const animated =
            document.querySelectorAll(
                '.fade-in-up'
            );

        if (
            'IntersectionObserver' in window
        ) {

            const observer =
                new IntersectionObserver(
                    function (entries, obs) {

                        entries.forEach(
                            function (entry) {

                                if (
                                    entry.isIntersecting
                                ) {

                                    entry.target
                                        .classList
                                        .add('visible');

                                    obs.unobserve(
                                        entry.target
                                    );
                                }
                            }
                        );
                    },
                    {
                        threshold: 0.08
                    }
                );

            animated.forEach(
                element =>
                    observer.observe(element)
            );

        } else {

            animated.forEach(
                element =>
                    element.classList
                        .add('visible')
            );
        }


        /*
         * ==========================================
         * Typewriter
         * ==========================================
         */

        const typewriter =
            document.getElementById(
                'typewriter'
            );

        if (typewriter) {

            const words = [
                'School',
                'College',
                'Clinic',
                'Kirana Store',
                'Coaching',
                'Hospital',
                'Business'
            ];

            let wordIndex = 0;
            let charIndex = 0;
            let deleting = false;

            function type() {

                const word =
                    words[wordIndex];

                if (deleting) {

                    charIndex--;

                } else {

                    charIndex++;

                }

                typewriter.textContent =
                    word.substring(
                        0,
                        charIndex
                    );

                let speed =
                    deleting
                        ? 45
                        : 90;

                if (
                    !deleting &&
                    charIndex === word.length
                ) {

                    speed = 1800;
                    deleting = true;

                } else if (
                    deleting &&
                    charIndex === 0
                ) {

                    deleting = false;

                    wordIndex =
                        (wordIndex + 1)
                        % words.length;

                    speed = 450;
                }

                setTimeout(
                    type,
                    speed
                );
            }

            typewriter.textContent = '';

            type();
        }


        /*
         * ==========================================
         * Directory search + filtering
         * ==========================================
         */

        const searchInput =
            document.getElementById(
                'searchInput'
            );

        const cards =
            document.querySelectorAll(
                '.directory .card'
            );

        const noResults =
            document.getElementById(
                'noResults'
            );

        const filterButtons =
            document.querySelectorAll(
                '.filter-btn'
            );

        if (
            searchInput &&
            cards.length
        ) {

            let currentFilter = 'all';

            function filterDirectory() {

                const query =
                    searchInput.value
                        .toLowerCase()
                        .trim();

                let visible = 0;

                cards.forEach(
                    function (card) {

                        const searchable =
                            card.getAttribute(
                                'data-search'
                            ) || '';

                        const category =
                            card.getAttribute(
                                'data-category'
                            ) || 'service';

                        const matchesSearch =
                            searchable.includes(
                                query
                            );

                        const matchesCategory =
                            currentFilter === 'all' ||
                            category === currentFilter;

                        const show =
                            matchesSearch &&
                            matchesCategory;

                        card.style.display =
                            show
                                ? ''
                                : 'none';

                        if (show) {
                            visible++;
                        }
                    }
                );

                if (noResults) {

                    noResults.style.display =
                        visible === 0
                            ? 'block'
                            : 'none';
                }
            }

            searchInput.addEventListener(
                'input',
                filterDirectory
            );

            filterButtons.forEach(
                function (button) {

                    button.addEventListener(
                        'click',
                        function () {

                            filterButtons
                                .forEach(
                                    b =>
                                        b.classList
                                            .remove(
                                                'active'
                                            )
                                );

                            button.classList
                                .add('active');

                            currentFilter =
                                button.getAttribute(
                                    'data-filter'
                                ) || 'all';

                            filterDirectory();
                        }
                    );
                }
            );
        }

    }
);
</script>

</body>
</html>
