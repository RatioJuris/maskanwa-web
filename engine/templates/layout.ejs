<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page.title %></title>
    <meta name="description" content="Official website of <%= site.name %>">
    <link rel="canonical" href="<%= page.canonical %>">
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; line-height: 1.6; color: #333; margin: 0; }
        header { background: #1a1a1a; color: white; padding: 1.5rem 2rem; }
        header a { color: white; text-decoration: none; font-size: 1.5rem; font-weight: bold; }
        nav { background: #f4f4f4; padding: 0.75rem 2rem; border-bottom: 1px solid #ddd; }
        nav a { margin-right: 1.5rem; color: #0056b3; text-decoration: none; font-weight: 500; }
        main { padding: 2rem; max-width: 800px; margin: 0 auto; min-height: 50vh; }
        footer { text-align: center; padding: 2rem; margin-top: 3rem; background: #f4f4f4; font-size: 0.9rem; }
        footer a { color: #0056b3; text-decoration: none; }
    </style>
</head>
<body>
    <header>
        <a href="/"><%= site.name %></a>
    </header>
    <nav>
        <a href="/">Home</a>
    </nav>
    <main>
        <%- content %>
    </main>
    <footer>
        <p>&copy; <%= new Date().getFullYear() %> <%= site.name %>.</p>
        <p>Powered by <a href="https://maskanwa.com">Maskanwa</a></p>
    </footer>
</body>
</html>
