<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Primary SEO Tags -->
    <title><%= page.title %></title>
    <meta name="title" content="<%= page.title %>">
    <meta name="description" content="<%= page.description || 'Official website of ' + site.name + ' in Maskanwa.' %>">
    <link rel="canonical" href="<%= page.canonical %>">
    
    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= page.canonical %>">
    <meta property="og:title" content="<%= page.title %>">
    <meta property="og:description" content="<%= page.description || 'Official website of ' + site.name + ' in Maskanwa.' %>">
    <meta property="og:site_name" content="<%= site.name %>">
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="<%= page.canonical %>">
    <meta property="twitter:title" content="<%= page.title %>">
    <meta property="twitter:description" content="<%= page.description || 'Official website of ' + site.name + ' in Maskanwa.' %>">

    <!-- Dynamic SVG Favicon (Auto-generates icon based on the first letter of the site name) -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%232563eb'/><text x='50' y='70' font-size='65' font-family='system-ui, sans-serif' font-weight='bold' fill='white' text-anchor='middle'><%= site.name.charAt(0).toUpperCase() %></text></svg>">
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%232563eb'/><text x='50' y='70' font-size='65' font-family='system-ui, sans-serif' font-weight='bold' fill='white' text-anchor='middle'><%= site.name.charAt(0).toUpperCase() %></text></svg>">

    <!-- JSON-LD Structured Data for Google Search -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "<%= site.type.toLowerCase().includes('school') || site.type.toLowerCase().includes('college') ? 'EducationalOrganization' : 'LocalBusiness' %>",
      "name": "<%= site.name %>",
      "url": "<%= page.canonical %>",
      "areaServed": "Maskanwa, Uttar Pradesh"
    }
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* ... Keep your existing CSS styles below this point ... */
        :root { --primary: #0f172a; --accent: #2563eb; --bg: #ffffff; --surface: #f8fafc; --text-main: #1e293b; --text-muted: #64748b; --border: #e2e8f0; }
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; margin: 0; background: var(--bg); color: var(--text-main); line-height: 1.7; -webkit-font-smoothing: antialiased; }
        header { position: sticky; top: 0; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); }
        .header-inner { max-width: 800px; margin: 0 auto; padding: 1.25rem 2rem; display: flex; justify-content: space-between; align-items: center; }
        .brand { font-size: 1.25rem; font-weight: 700; color: var(--primary); text-decoration: none; letter-spacing: -0.02em; }
        nav a { margin-left: 1.5rem; color: var(--text-muted); text-decoration: none; font-weight: 500; font-size: 0.95rem; }
        nav a:hover { color: var(--primary); }
        main { max-width: 800px; margin: 0 auto; padding: 3rem 2rem; min-height: 60vh; }
        main h1 { font-size: 2.5rem; font-weight: 800; color: var(--primary); letter-spacing: -0.03em; margin-bottom: 1.5rem; line-height: 1.2; }
        main h2 { font-size: 1.75rem; font-weight: 600; color: var(--primary); margin-top: 2.5rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); }
        main h3 { font-size: 1.25rem; font-weight: 600; margin-top: 2rem; }
        main p { font-size: 1.125rem; margin-bottom: 1.5rem; }
        main ul, main ol { font-size: 1.125rem; margin-bottom: 1.5rem; padding-left: 1.5rem; }
        main li { margin-bottom: 0.5rem; }
        main a { color: var(--accent); text-decoration: none; font-weight: 500; }
        main a:hover { text-decoration: underline; }
        main blockquote { border-left: 4px solid var(--accent); margin: 0 0 1.5rem 0; padding: 1rem 1.5rem; background: var(--surface); border-radius: 0 8px 8px 0; color: #475569; font-style: italic; }
        main img { max-width: 100%; height: auto; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
        table { width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 1rem; }
        th, td { padding: 1rem; text-align: left; border-bottom: 1px solid var(--border); }
        th { background: var(--surface); font-weight: 600; color: var(--primary); }
        footer { border-top: 1px solid var(--border); padding: 3rem 2rem; text-align: center; color: var(--text-muted); font-size: 0.95rem; background: var(--surface); }
        footer a { color: var(--accent); text-decoration: none; font-weight: 500; }
        .update-badge { display: inline-block; margin-top: 1rem; padding: 0.25rem 0.75rem; background: #fff; border: 1px solid var(--border); border-radius: 6px; font-size: 0.85rem; font-family: monospace; color: #94a3b8; }
    </style>
</head>
